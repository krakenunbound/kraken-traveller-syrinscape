<?xml version="1.0" encoding="utf-8"?>
<root>
  <windowclass name="krakensyrin_options">
    <frame>utilitybox</frame>
    <sizelimits><minimum width="330" height="395" /></sizelimits>
    <sheetdata>

      <!-- ============================================================
           Shared controller: defines helpers used by all buttons.
           All category toggle logic lives here (one copy, not 17).
           ============================================================ -->
      <genericcontrol name="ctrl">
        <bounds rect="0,0,1,1" />
        <script>
CATS = { "ship", "comms", "weapons", "damage", "status", "skills", "tasks" }

function getEnabled(catId)
  if CCSyrin and CCSyrin.isCategoryEnabled then
    return CCSyrin.isCategoryEnabled(catId)
  end
  return true
end

function setEnabled(catId, val)
  if CCSyrin and CCSyrin.setCategoryEnabled then
    CCSyrin.setCategoryEnabled(catId, val)
  end
end

function refreshLabel(catId)
  local ctrl = window["state_" .. catId]
  if ctrl then
    ctrl.setValue(getEnabled(catId) and "On" or "Off")
  end
end

function refreshAll()
  for _, c in ipairs(CATS) do
    refreshLabel(c)
  end
  refreshSummary()
end

function refreshSummary()
  local n = 0
  for _, c in ipairs(CATS) do
    if getEnabled(c) then n = n + 1 end
  end
  if window.summary then
    window.summary.setValue("Enabled categories: " .. n .. " / " .. #CATS)
  end
end

function toggle(catId)
  local val = not getEnabled(catId)
  setEnabled(catId, val)
  refreshLabel(catId)
  refreshSummary()
end

function enableAll()
  for _, c in ipairs(CATS) do
    setEnabled(c, true)
  end
  refreshAll()
end

function disableAll()
  for _, c in ipairs(CATS) do
    setEnabled(c, false)
  end
  refreshAll()
end

function onInit()
  refreshAll()
end
        </script>
      </genericcontrol>

      <!-- Header -->
      <stringcontrol name="title">
        <bounds rect="20,18,280,24" />
        <font>sheetlabel</font>
        <static text="Kraken Traveller 2E Syrinscape" />
      </stringcontrol>
      <stringcontrol name="subtitle">
        <bounds rect="20,42,280,20" />
        <font>sheettext</font>
        <static text="Toggle sound categories on or off." />
      </stringcontrol>
      <stringcontrol name="summary">
        <bounds rect="20,62,280,20" />
        <font>sheettext</font>
        <static text="Enabled categories: 0 / 7" />
      </stringcontrol>

      <!-- Close button -->
      <buttoncontrol name="button_close">
        <bounds rect="298,14,20,20" />
        <frame name="windowmenubar_button" offset="2,2,2,2" />
        <stateframe>
          <pressed name="windowmenubar_button_down" offset="2,2,2,2" nobaseframe="true" />
        </stateframe>
        <icon>button_toolbar_window_close</icon>
        <tooltip text="Close" />
        <script>
function onInit() setColor(ColorManager.getWindowMenuIconColor()) end
function onButtonPress() window.close() end
        </script>
      </buttoncontrol>

